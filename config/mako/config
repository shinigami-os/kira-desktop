font=Raleway 13
background-color=#1c1828ff
text-color=#e8d8ffff
border-color=#aa00ffcc
border-size=1
border-radius=8

width=360
height=120
anchor=top-center
margin=40
padding=12

default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time

icons=1
icon-path=/usr/share/icons/hicolor
max-icon-size=48

[urgency=low]
border-color=#6b4f9eff
default-timeout=3000

[urgency=normal]
border-color=#aa00ffcc

[urgency=critical]
border-color=#ff00aaff
text-color=#ff00aaff
default-timeout=0