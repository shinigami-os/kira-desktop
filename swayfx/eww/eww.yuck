;; ============================================================
;; Kira Linux - eww bar (based on elkowar's eww-bar example)
;; ============================================================

;; -- Polls ---------------------------------------------------

(defpoll clock_time :interval "5s"
  "date '+%H:%M'")

(defpoll clock_date :interval "60s"
  "date '+%a %d %b'")

(defpoll cpu_temp :interval "5s"
  "cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{printf \"%.0f\", $1/1000}' || echo '?'")

(defpoll net_label :interval "5s"
  "ip link show | awk -F': ' '/^[0-9]+: /{iface=$2} /UP/ && iface != \"lo\" {print iface; exit}' || echo 'none'")

(defpoll net_ssid :interval "10s"
  "iw dev 2>/dev/null | awk '/Interface/{i=$2} /ssid/{print $2; exit}' || echo ''")

(defpoll vol_val :interval "1s"
  "pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{gsub(/%/,\"\"); print $5}' || echo '0'")

(defpoll vol_muted :interval "1s"
  "pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}' || echo 'no'")

(defpoll workspaces :interval "0.3s"
  `swaymsg -t get_workspaces | python3 -c "
import json,sys
ws=json.load(sys.stdin)
icons=['','','','','','','','','','']
result=[]
for w in sorted(ws,key=lambda x:x['num']):
    result.append({
        'num': w['num'],
        'icon': icons[min(w['num']-1,len(icons)-1)],
        'focused': w['focused'],
        'urgent': w['urgent']
    })
print(json.dumps(result))
"`)

(defpoll window_title :interval "0.5s"
  `swaymsg -t get_tree | python3 -c "
import json,sys
tree=json.load(sys.stdin)
def find_focused(n):
    if n.get('focused'): return n.get('name','')
    for c in n.get('nodes',[])+n.get('floating_nodes',[]):
        r=find_focused(c)
        if r is not None: return r
    return None
t=find_focused(tree) or ''
print(t[:60])
" 2>/dev/null`)

(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true")

;; -- Default values ------------------------------------------

(defvar vol_val "0")
(defvar battery_val "0")

;; -- Metric widget (elkowar style) ---------------------------

(defwidget metric [icon value ?onchange ?max]
  (box :class "metric"
       :orientation "h"
       :space-evenly false
       :spacing 6
    (label :class "metric-icon" :text icon)
    (scale :class "metric-bar"
           :min 0
           :max {max ?: 101}
           :active {onchange != "" && onchange != "false"}
           :value value
           :onchange {onchange ?: ""})))

;; -- Workspaces ----------------------------------------------

(defwidget workspace-btn [num icon focused urgent]
  (button
    :class {focused ? "ws-btn focused" : urgent ? "ws-btn urgent" : "ws-btn"}
    :onclick "swaymsg workspace number ${num}"
    icon))

(defwidget workspaces-widget []
  (box :class "workspaces" :spacing 4 :space-evenly false
    (for ws in workspaces
      (workspace-btn
        :num     {ws.num}
        :icon    {ws.icon}
        :focused {ws.focused}
        :urgent  {ws.urgent}))))

;; -- Clock ---------------------------------------------------

(defwidget clock-widget []
  (box :class "clock" :spacing 4 :space-evenly false
    (label :class "clock-time" :text clock_time)
    (label :class "clock-date" :text clock_date)))

;; -- Music ---------------------------------------------------

(defwidget music-widget []
  (box :class "music"
       :space-evenly false
       :spacing 6
    {music != "" ? "󰎇 ${music}" : ""}))

;; -- Network -------------------------------------------------

(defwidget network-widget []
  (box :class "net" :space-evenly false :spacing 4
    (label :class "net-icon"
           :text {net_label == "none" ? "󰤭" :
                  net_ssid  != ""     ? "󰤨" : "󰈀"})
    (label :class "net-label"
           :text {net_ssid != "" ? net_ssid : net_label})))

;; -- Battery -------------------------------------------------

(defwidget battery-widget []
  (box :class "battery"
       :visible {EWW_BATTERY != ""}
       :space-evenly false
       :spacing 4
    (label :class "bat-icon"
           :text {EWW_BATTERY["BAT0"].status == "Charging" ? "󰂄" :
                  EWW_BATTERY["BAT0"].capacity > 80 ? "󰁹" :
                  EWW_BATTERY["BAT0"].capacity > 60 ? "󰂀" :
                  EWW_BATTERY["BAT0"].capacity > 40 ? "󰁾" :
                  EWW_BATTERY["BAT0"].capacity > 20 ? "󰁼" : "󰁺"})
    (label :text "${EWW_BATTERY["BAT0"].capacity}%")))

;; -- Left / Center / Right -----------------------------------

(defwidget bar-left []
  (box :class "bar-left" :space-evenly false :spacing 12
    (label :class "window-title" :limit-width 50 :text window_title)
    (music-widget)))

(defwidget bar-center []
  (box :class "bar-center" :space-evenly false :spacing 8
    (metric :icon "" :value {round(EWW_CPU.avg, 0)} :onchange "false")
    (label :class "metric-label" :text "${round(EWW_CPU.avg, 0)}%")
    (metric :icon "" :value {round(EWW_RAM.used_mem_perc, 0)} :onchange "false")
    (label :class "metric-label" :text "${round(EWW_RAM.used_mem_perc, 0)}%")
    (label :class "temp-label" :text "󰔏 ${cpu_temp}°C")
    (workspaces-widget)
    (clock-widget)))

(defwidget bar-right []
  (box :class "bar-right" :space-evenly false :spacing 8
    (metric :icon {vol_muted == "yes" ? "󰝟" : "󰕾"}
            :value vol_val
            :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
    (network-widget)
    (battery-widget)))

;; -- Main bar widget -----------------------------------------

(defwidget bar-widget [monitor]
  (box :class "bar"
       :orientation "h"
       :space-evenly false
    (box :hexpand true :halign "start" :space-evenly false
      (bar-left))
    (box :hexpand true :halign "center" :space-evenly false
      (bar-center))
    (box :hexpand true :halign "end" :space-evenly false
      (bar-right))))

;; -- Window --------------------------------------------------

(defwindow bar
  :monitor monitor
  :geometry (geometry
    :x "0px" :y "0px"
    :width "100%" :height "36px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar-widget :monitor monitor))