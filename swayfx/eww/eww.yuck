;; ╔══════════════════════════════════════════════════════════════════╗
;; ║  Kira Linux · eww · "Kira Shell"                                 ║
;; ║  5 floating islands · driven by shell scripts + sway IPC         ║
;; ╚══════════════════════════════════════════════════════════════════╝

;; ─────────────────────────── data sources ───────────────────────────
(deflisten workspaces :initial "[]" "scripts/workspaces.sh")
(deflisten ws_focus   :initial '{"num":1,"name":"the usual"}' "scripts/ws_focus.sh")
(deflisten mediajson  :initial '{"status":"Stopped","artist":"","title":""}' "scripts/media.sh")

(defpoll cpu        :interval "2s"  :initial "0"            "scripts/cpu.sh")
(defpoll mem        :interval "3s"  :initial "0.0"          "scripts/mem.sh")
(defpoll temp       :interval "3s"  :initial "0"            "scripts/temp.sh")
(defpoll vol        :interval "1s"  :initial "0"            "scripts/vol.sh")
(defpoll eth        :interval "5s"  :initial "0"            "scripts/net.sh")
(defpoll notifcount :interval "3s"  :initial "0"            "scripts/notifcount.sh")

(defpoll time_main  :interval "10s" :initial "--:--"        "date +%H:%M")
(defpoll time_sec   :interval "1s"  :initial "00"           "date +%S")
(defpoll date_str   :interval "60s" :initial ""             "date '+%a %d %b' | tr '[:upper:]' '[:lower:]'")

;; ══════════════════════════ WORKSPACE MINI ══════════════════════════
;; workspaces.sh emits: [{num, focused, wins:[{l,t,w,h,f}]}]

(defwidget ws-mini [w]
  (eventbox :onclick "swaymsg workspace number ${w.num}" :cursor "pointer"
    (box :class "ws-mini ${w.focused ? "ws-mini-active" : ""}" :valign "center" :halign "center"
      (image :path {w.img} :image-width 34 :image-height 22))))

;; ══════════════════════════ ISLANDS ══════════════════════════

(defwidget island-workspaces []
  (box :class "island" :space-evenly false :spacing 9 :valign "center" :halign "start"
    (box :space-evenly false :spacing 9
      (for w in workspaces
        (ws-mini :w w)))
    (eventbox :onclick "scripts/popup.sh overview" :cursor "pointer"
      (box :orientation "v" :space-evenly false :spacing 1 :valign "center"
        (label :class "ws-digit" :halign "start" :text "0${ws_focus.num}")
        (label :class "ws-name" :halign "start" :text {ws_focus.name})))))

(defwidget island-media []
  (eventbox :onclick "scripts/popup.sh music" :cursor "pointer" :halign "start" :hexpand false
    (box :class "island" :space-evenly false :spacing 12 :valign "center" :halign "start"
      (box :class "eq ${mediajson.status == "Playing" ? "eq-on" : "eq-off"}"
           :space-evenly false :spacing 2 :valign "center"
        (box :class "eq-bar b1")
        (box :class "eq-bar b2")
        (box :class "eq-bar b3"))
      (label :class "media-text"
             :text {mediajson.title == "" ? "nothing playing" : "${mediajson.artist}  —  ${mediajson.title}"}
             :halign "start"))))

(defwidget island-clock []
  (eventbox :onclick "scripts/popup.sh calendar" :onrightclick "scripts/voice.sh --say 'time is a construct. anyway.'" :cursor "pointer" :halign "center" :hexpand false
    (box :class "island" :space-evenly false :spacing 12 :valign "center" :halign "center"
      (label :class "clock-main" :text time_main)
      (box :orientation "v" :space-evenly false :spacing 1 :valign "center"
        (label :class "clock-sec" :halign "start" :text time_sec)
        (label :class "clock-date" :halign "start" :text date_str)))))


;; ── battery: 5-cell frame + nub (hidden when no battery) ──
(defwidget bat-widget []
  (box :space-evenly false :spacing 6 :valign "center"
       :visible {batjson.present}
       :tooltip {batjson.charging ? "charging — ${batjson.pct}%" : "on battery — ${batjson.pct}%"}
    (box :space-evenly false :spacing 0 :valign "center"
      (box :class "bat-frame ${batjson.charging ? "bat-chg" : ""} ${batjson.low ? "bat-low" : ""}"
           :space-evenly false :spacing 2 :valign "center"
        (for c in {batjson.cells}
          (box :class "bat-cell ${c == 1 ? "cell-on" : "cell-off"}" :valign "center")))
      (box :class "bat-nub" :valign "center"))
    (label :class "vital-val" :text "${batjson.pct}%")))

(defwidget island-vitals []
  (box :class "island" :space-evenly false :spacing 16 :valign "center" :halign "end" :hexpand false
    (graph :class "spark" :valign "center"
           :hexpand false :vexpand false
           :width 46 :height 20
           :value cpu :time-range "50s"
           :min 0 :max 100 :dynamic true
           :thickness 1.4 :line-style "round")
    (eventbox :onclick "scripts/popup.sh sysmon" :cursor "pointer" :hexpand false
      (box :space-evenly false :spacing 16 :valign "center"
        (box :space-evenly false :spacing 8 :valign "center"
          (label :class "vital-txt" :text "cpu")
          (label :class "vital-val" :text "${cpu}%"))
        (box :class "vital-div")
        (label :class "vital-txt" :text "ram")
        (label :class "vital-val" :text "${mem}%")
        (box :class "vital-div")
        (label :class "vital-val" :text "${temp}°c")))
    (box :class "vital-div")
    (eventbox :onclick "scripts/popup.sh control" :cursor "pointer" :hexpand false
      (box :space-evenly false :spacing 14 :valign "center"
        (box :space-evenly false :spacing 5 :valign "center"
          (label :class "vital-txt" :text "vol")
          (label :class "vital-val" :text "${vol}%"))
        (bat-widget)
        (box :space-evenly false :spacing 5 :valign "center"
          (label :class "vital-txt" :text "eth")
          (box :valign "center" :vexpand false :hexpand false
            (box :class "eth-dot ${eth == "1" ? "eth-on" : "eth-off"}" :vexpand false :hexpand false)))))))

(defwidget island-notif []
  (eventbox :onclick "scripts/popup.sh notif" :cursor "pointer"
    (box :class "island island-notif ${notifcount != "0" ? "notif-pulse" : ""}"
         :valign "center" :halign "center"
      (label :class "notif-count ${notifcount != "0" ? "notif-has" : "notif-empty"}"
             :text notifcount))))

;; ══════════════════════════ WINDOWS ══════════════════════════
;; One window per island (maquette positions: 28px, 470px, center,
;; right 110px, right 28px; all at y 26). Separate windows let SwayFX
;; layer_effects apply blur + shadow per island instead of full-width.
;; All non-exclusive; space is reserved via "gaps top" in sway config.

(defwindow bar-ws
  :monitor 0
  :geometry (geometry :x "28px" :y "13px" :width "360px" :height "56px" :anchor "top left")
  :stacking "fg" :exclusive false :namespace "eww-bar"
  (island-workspaces))

(defwindow bar-media
  :monitor 0
  :geometry (geometry :x "360px" :y "13px" :width "400px" :height "56px" :anchor "top left")
  :stacking "fg" :exclusive false :namespace "eww-bar"
  (island-media))

(defwindow bar-clock
  :monitor 0
  :geometry (geometry :x "0" :y "13px" :width "192px" :height "56px" :anchor "top center")
  :stacking "fg" :exclusive false :namespace "eww-bar"
  (island-clock))

(defwindow bar-vitals
  :monitor 0
  :geometry (geometry :x "110px" :y "13px" :width "522px" :height "56px" :anchor "top right")
  :stacking "fg" :exclusive false :namespace "eww-bar"
  (island-vitals))

(defwindow bar-notif
  :monitor 0
  :geometry (geometry :x "28px" :y "13px" :width "56px" :height "56px" :anchor "top right")
  :stacking "fg" :exclusive false :namespace "eww-bar"
  (island-notif))

(include "popups.yuck")
