# =============================================================================
# Kira Linux - SwayFX Configuration
# =============================================================================

set $mod Mod4
set $term foot
set $launcher fuzzel
set $files pcmanfm-qt
set $settings kira-settings
set $locker swaylock-effects --color 0a0a0f --effect-blur 7x5 --clock

font pango:Raleway 11

# Output
output * bg /usr/share/kira/wallpapers/default.png fill

# Input
input "type:touchpad" {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
    scroll_method two_finger
}

input "type:keyboard" {
    xkb_layout fr
    xkb_variant azerty
}

# Appearance
gaps inner 4
gaps outer 8

default_border pixel 2
default_floating_border pixel 2

corner_radius 8

shadows enable
shadow_blur_radius 20
shadow_color #0a0a0fCC

blur enable
blur_passes 3
blur_radius 5

xwayland disable

focus_follows_mouse no

# Window colors
client.focused          #aa00ff #1c1828 #e8d8ff #aa00ff #aa00ff
client.focused_inactive #2a2240 #12101a #b09acc #2a2240 #2a2240
client.unfocused        #2a2240 #12101a #6b4f9e #2a2240 #2a2240
client.urgent           #ff00aa #1c1828 #e8d8ff #ff00aa #ff00aa

# Keybindings
bindsym ctrl+alt+t          exec $term
bindsym $mod+d              exec $launcher
bindsym $mod+e              exec $files
bindsym $mod+u              exec $settings
bindsym $mod+r              exec kira-run
bindsym $mod+c              exec menu-qalc-wayland

bindsym $mod+q              kill
bindsym $mod+f              fullscreen toggle
bindsym $mod+h              splith
bindsym $mod+v              splitv
bindsym $mod+Shift+Space    floating toggle

bindsym $mod+i              focus up
bindsym $mod+j              focus left
bindsym $mod+o              focus down
bindsym $mod+k              focus right

bindsym $mod+Up             move up
bindsym $mod+Down           move down
bindsym $mod+Left           move left
bindsym $mod+Right          move right

bindsym $mod+1              workspace number 1
bindsym $mod+2              workspace number 2
bindsym $mod+3              workspace number 3
bindsym $mod+4              workspace number 4
bindsym $mod+5              workspace number 5
bindsym $mod+6              workspace number 6
bindsym $mod+7              workspace number 7
bindsym $mod+8              workspace number 8
bindsym $mod+9              workspace number 9
bindsym $mod+0              workspace number 10

bindsym $mod+Shift+1        move container to workspace number 1
bindsym $mod+Shift+2        move container to workspace number 2
bindsym $mod+Shift+3        move container to workspace number 3
bindsym $mod+Shift+4        move container to workspace number 4
bindsym $mod+Shift+5        move container to workspace number 5
bindsym $mod+Shift+6        move container to workspace number 6
bindsym $mod+Shift+7        move container to workspace number 7
bindsym $mod+Shift+8        move container to workspace number 8
bindsym $mod+Shift+9        move container to workspace number 9
bindsym $mod+Shift+0        move container to workspace number 10

bindsym $mod+Alt+Left       workspace prev
bindsym $mod+Alt+Right      workspace next
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

bindsym $mod+Shift+Alt+Left     move container to workspace prev
bindsym $mod+Shift+Alt+Right    move container to workspace next

bindsym $mod+minus          scratchpad show
bindsym $mod+Shift+minus    move scratchpad

bindsym Print               exec flameshot gui
bindsym $mod+Shift+s        exec flameshot gui

bindsym $mod+l              exec $locker
bindsym $mod+Shift+r        reload

# Floating rules
for_window [app_id="floating_foot"]        floating enable, resize set 800 500
for_window [app_id="kira-settings"]        floating enable
for_window [app_id="pavucontrol"]          floating enable, resize set 700 450
for_window [app_id="nm-connection-editor"] floating enable

# Autostart
# exec_always kira-theme apply $(cat $HOME/.config/kira-desktop/current-theme 2>/dev/null || echo "kira-default")
exec dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec mako
exec $HOME/.config/eww/launch-bars.sh
exec flameshot
exec pipewire &
exec pipewire-pulse &
exec wireplumber &