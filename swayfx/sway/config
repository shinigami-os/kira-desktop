# ╔══════════════════════════════════════════════════════════════════╗
# ║  Kira Linux · SwayFX config · "Trinity"                          ║
# ╚══════════════════════════════════════════════════════════════════╝

### ─── modifier ───
set $mod Mod4
set $term foot
set $menu fuzzel
set $explorer pcmanfm-qt
set $locker hyprlock

### ─── input ───
input "type:touchpad" {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
    scroll_method two_finger
}

input "type:keyboard" {
    xkb_layout fr
    xkb_variant azerty
    xkb_numlock enabled
}

### ─── output / wallpaper ───
output * bg /usr/share/kira/wallpapers/default.png fill

### ─── fonts ───
font pango:JetBrains Mono 10

### ═══════════════════ SwayFX eye-candy ═══════════════════
corner_radius 11
xwayland disable
focus_follows_mouse yes

blur enable
blur_xray disable
blur_passes 3
blur_radius 6

shadows enable
shadows_on_csd enable
shadow_blur_radius 26
shadow_color #000000cc

default_dim_inactive 0.12
dim_inactive_colors.unfocused #07060bff
dim_inactive_colors.urgent    #ff00aaff

titlebar_padding 1
title_align center

### ─── gaps & borders ───
gaps inner 8
gaps outer 8
gaps top 88
smart_gaps off
default_border pixel 2
default_floating_border pixel 2
smart_borders on

### ─── window colours ───     border    bg      text    indicator  child_border
client.focused           #aa00ff   #0a0a0f  #e8d8ff  #aa00ff    #aa00ff
client.focused_inactive  #3d3060   #0a0a0f  #6b4f9e  #3d3060    #3d3060
client.unfocused         #1c1828   #0a0a0f  #6b4f9e  #1c1828    #1c1828
client.urgent            #ff00aa   #0a0a0f  #e8d8ff  #ff00aa    #ff00aa

### ─── per-app opacity (so blur shows) ───
for_window [app_id="foot"]      opacity 0.90
for_window [app_id="Alacritty"] opacity 0.90
for_window [app_id="thunar"]    opacity 0.96

### ─── floating rules ───
for_window [app_id="pavucontrol"]          floating enable, resize set 520 640
for_window [app_id="foot" title="scratch"] floating enable
for_window [title="Picture-in-Picture"]    floating enable, sticky enable
for_window [app_id="eww"]                   border none

### ═══════════════════ keybindings ═══════════════════
# launch
bindsym $mod+Return  exec $term
bindsym $mod+s       exec $menu
bindsym $mod+e       exec $explorer
bindsym $mod+q       kill
bindsym $mod+l       exec $locker
bindsym $mod+Shift+q exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+r reload

# screenshot
bindsym Print        exec flameshot gui
bindsym $mod+Shift+s exec flameshot gui

# ─── Kira Shell · popups / modals (dispatcher) ───
bindsym $mod+w        exec ~/.config/eww/scripts/popup.sh overview
bindsym $mod+c        exec ~/.config/eww/scripts/popup.sh control
bindsym $mod+n        exec ~/.config/eww/scripts/popup.sh notif
bindsym $mod+m        exec ~/.config/eww/scripts/popup.sh music
bindsym $mod+d        exec ~/.config/eww/scripts/popup.sh calendar
bindsym $mod+i        exec ~/.config/eww/scripts/popup.sh sysmon
bindsym $mod+p        exec ~/.config/eww/scripts/popup.sh power
bindsym $mod+Escape   exec ~/.config/eww/scripts/popup.sh close-all

# focus (azerty zqsd-friendly but uhjk)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+u focus up
bindsym $mod+k focus right

# move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+u move up
bindsym $mod+Shift+k move right

# workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

# layout
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+v splitv
bindsym $mod+b splith

# media / volume / brightness keys
bindsym XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay         exec playerctl play-pause
bindsym XF86AudioNext         exec playerctl next
bindsym XF86AudioPrev         exec playerctl previous
bindsym XF86MonBrightnessUp   exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### ─── resize mode ───
mode "resize" {
    bindsym h resize shrink width 40px
    bindsym l resize grow width 40px
    bindsym k resize shrink height 40px
    bindsym j resize grow height 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### ═══════════════════ layer_effects (per-island glass) ═══════════════════
layer_effects "eww-bar"       blur enable; corner_radius 11
layer_effects "eww-popup"     blur enable; corner_radius 13
layer_effects "launcher"      blur enable; corner_radius 14
layer_effects "notifications" blur enable; corner_radius 14

### ═══════════════════ autostart ═══════════════════
exec dbus-update-activation-environment --all
exec /usr/bin/pipewire &
exec /usr/bin/pipewire-pulse &
exec /usr/bin/wireplumber &
exec mako
exec_always ~/.config/eww/launch-bars.sh
exec swayidle -w \
        timeout 300 'hyprlock' \
        timeout 600 'swaymsg "output * dpms off"' \
             resume 'swaymsg "output * dpms on"' \
        before-sleep 'hyprlock'

include /etc/sway/config.d/*
