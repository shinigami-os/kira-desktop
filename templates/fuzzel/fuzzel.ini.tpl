# ===================================
# Kira Linux - fuzzel configuration
# ===================================

[main]
font=Raleway:size=13
icon-theme=hicolor
icons-enabled=yes
terminal=foot
layer=overlay
exit-on-keyboard-focus-loss=yes
lines=10
width=35
horizontal-pad=12
vertical-pad=8
inner-pad=4
image-size-ratio=0.5
prompt=> 
placeholder=Type to search

[colors]
background=%fz_surface0%
text=%fz_text%
match=%fz_primary%
selection=%fz_surface2%
selection-text=%fz_text%
selection-match=%fz_primary%
border=%fz_primary%

[border]
width=1
radius=8

[dmenu]
exit-immediately-if-empty=no